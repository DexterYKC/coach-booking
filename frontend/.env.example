# Copy this file to .env.local for local development.
# On Netlify: set these in Site settings → Environment variables (do NOT commit real values).

# --- Supabase (required to leave mock/demo mode) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Test accounts seeded by scripts/seed-admin.mjs (run once after migrations) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
COACH_EMAIL=coach@example.com
COACH_PASSWORD=
CLIENT_EMAIL=client@example.com
CLIENT_PASSWORD=

# --- Optional: show demo account credentials on /login and /register ---
# Set to "true" on the Netlify demo site only — leave unset in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=

# --- Optional: email notifications (leave empty to no-op / log only) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Optional: WhatsApp notifications (leave empty to no-op / log only) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_FROM_NUMBER=
WHATSAPP_API_URL=
